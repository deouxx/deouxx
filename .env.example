# ============================================================
# TEMPLATE KONFIGURASI .ENV (DATABASE & HOSTING)
# ============================================================

# Pilihan Driver: "mysql" atau "sqlite"
DB_DRIVER=sqlite

# Untuk MySQL / MariaDB (Hosting cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dapur_ina
DB_USER=root
DB_PASS=

# Aplikasi URL
APP_URL=http://localhost:8000
APP_ENV=development
